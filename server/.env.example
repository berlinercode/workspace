# Server Configuration
PORT=5000

# OpenWeatherMap API (kostenlos bei openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# GeoNames API (kostenlos bei geonames.org)
GEONAMES_USERNAME=your_geonames_username_here

# Optional: Weitere APIs
# NOAA und SWPC APIs sind öffentlich und benötigen keine Keys